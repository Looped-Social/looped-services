# Server
PORT=8080

# Database (Postgres)
DB_URL=jdbc:postgresql://localhost:5432/looped
DB_USERNAME=looped
DB_PASSWORD=looped
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# AWS / Media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
S3_BUCKET=looped-dev-media
CLOUDFRONT_DOMAIN=
# Messaging (private DM/group chat media; presigned URLs only)
S3_MESSAGING_BUCKET=
S3_MESSAGING_REGION=

# Logo.dev
LOGO_DEV_TOKEN=
LOGO_DEV_RETINA=true
LOGO_DEV_SIZE=256

# Media
# Prefer *_SIZE for readability (e.g., "20MB", "256MB"); *_BYTES are supported for backward compatibility.
MEDIA_MAX_IMAGE_SIZE=10MB
MEDIA_MAX_VIDEO_SIZE=100MB
#MEDIA_MAX_IMAGE_BYTES=10485760
#MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_CALLBACK_SECRET=
MEDIA_SANITIZE_IMAGES_ON_CALLBACK=true
MEDIA_MAX_IMAGE_DIMENSION=8192
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_NORMALIZED_MAX_IMAGE_DIMENSION=2048
MEDIA_NORMALIZED_JPEG_QUALITY=0.82
COMMUNITY_LOGOS_ALLOW_EXTERNAL_CUSTOM_URL=false

# Auth (Firebase or any OIDC JWT provider)
# Firebase defaults shown; override per environment
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
AUTH_JWKS_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Firebase Admin (optional, for account deletion)
FIREBASE_ADMIN_CREDENTIALS_JSON=
FIREBASE_ADMIN_CREDENTIALS_PATH=
#admin edits
FIREBASE_ADMIN_REQUIRED=false

# SQS
SQS_NOTIF_QUEUE_URL=

# Verification
VERIFICATION_ECHO_CODE=false
VERIFICATION_CODE_TTL_SECONDS=600

# Email (SES)
EMAIL_ENABLED=true
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFY_BASE_URL=
EMAIL_CONFIGURATION_SET=

# Onboarding
ONBOARDING_DEFAULT_COMPANY_DOMAIN=looped.global

# App config (soft minimum version reminder for iOS)
APP_MINIMUM_SUPPORTED_VERSION=
APP_MINIMUM_SUPPORTED_VERSION_MESSAGE=
APP_MINIMUM_SUPPORTED_VERSION_UPDATE_URL=

# Universal Links / Well-known
UL_APPLE_TEAM_ID=REPLACE_TEAM_ID
UL_IOS_BUNDLE_ID=REPLACE_BUNDLE_ID
UL_CACHE_MAX_AGE_SECONDS=300
UL_AASA_VERSION=v1
# Optional Android placeholder
UL_ANDROID_PACKAGE_NAME=
UL_ANDROID_SHA256_CERT_FINGERPRINT=

# Retention
RETENTION_DEACTIVATED_DAYS=90
RETENTION_USERNAME_TOMBSTONE_DAYS=14

# Anonymous issuer (blind RSA community issuer keys)
# Optional but recommended in prod: KEK for encrypting issuer private keys at rest (32-byte base64).
ANON_ISSUER_KID=dev-issuer
ANON_ISSUER_KEK=
ANON_ISSUER_KEY_BITS=2048
ANON_CERT_MAX_AGE=365d

# Rate Limits (optional overrides)
RL_IP_WINDOW_SECONDS=60
RL_IP_MAX_REQUESTS=120
RL_USER_WINDOW_SECONDS=60
RL_USER_MAX_REQUESTS=180

# Widgets
WIDGET_SNAPSHOT_TTL_SECONDS=900

# Moderation / Quarantine
# Note: the checked-in blocklist file is intentionally empty. Manage real terms via the admin blocklist API.
MODERATION_ENABLED=true
MODERATION_REPORT_QUARANTINE_THRESHOLD=10
MODERATION_BLOCKLIST_RESOURCE=classpath:moderation/blocklist.txt
# MODERATION_BLOCKLIST_TERMS is supported but not recommended; prefer the DB-backed admin-managed blocklist.
MODERATION_BLOCKLIST_TERMS=
MODERATION_OPENAI_ENABLED=false
MODERATION_OPENAI_API_KEY=
MODERATION_OPENAI_MODEL=omni-moderation-latest
MODERATION_OPENAI_BASE_URL=https://api.openai.com/v1
MODERATION_OPENAI_CATEGORY_BLOCKLIST=hate,hate/threatening,sexual,sexual/minors,self-harm,self-harm/intent,self-harm/instructions,violence,violence/graphic
MODERATION_OPENAI_TIMEOUT_MILLIS=2000
# Soft cap to prevent exhausting external provider daily quota. Set <=0 to disable.
MODERATION_OPENAI_DAILY_REQUEST_BUDGET=9000
# Redis prefix for moderation budget counters/lockouts.
MODERATION_OPENAI_BUDGET_REDIS_PREFIX=moderation:openai:requests
