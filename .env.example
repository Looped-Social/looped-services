# Server
PORT=8080

# Database (Postgres)
DB_URL=jdbc:postgresql://localhost:5432/looped
DB_USERNAME=looped
DB_PASSWORD=looped
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# AWS / Media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
S3_BUCKET=looped-dev-media
CLOUDFRONT_DOMAIN=

# Logo.dev
LOGO_DEV_TOKEN=
LOGO_DEV_RETINA=true

# Media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_CALLBACK_SECRET=

# Auth (Firebase or any OIDC JWT provider)
# Firebase defaults shown; override per environment
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
AUTH_JWKS_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Firebase Admin (optional, for account deletion)
FIREBASE_ADMIN_CREDENTIALS_JSON=
FIREBASE_ADMIN_CREDENTIALS_PATH=
FIREBASE_ADMIN_REQUIRED=false

# SQS
SQS_NOTIF_QUEUE_URL=

# Verification
VERIFICATION_ECHO_CODE=false
VERIFICATION_CODE_TTL_SECONDS=600

# Email (SES)
EMAIL_ENABLED=true
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFY_BASE_URL=
EMAIL_CONFIGURATION_SET=

# Onboarding
ONBOARDING_DEFAULT_COMPANY_DOMAIN=looped.global

# Retention
RETENTION_DEACTIVATED_DAYS=90
RETENTION_USERNAME_TOMBSTONE_DAYS=14

# Anonymous issuer (override defaults in application.yaml)
ANON_ISSUER_KID=dev-issuer
ANON_ISSUER_PRIVATE_KEY_PEM=
ANON_ISSUER_PUBLIC_KEY_PEM=
ANON_CERT_MAX_AGE=365d

# Rate Limits (optional overrides)
RL_IP_WINDOW_SECONDS=60
RL_IP_MAX_REQUESTS=120
RL_USER_WINDOW_SECONDS=60
RL_USER_MAX_REQUESTS=180
