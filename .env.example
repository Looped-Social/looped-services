# Server
PORT=8080

# Database (Postgres)
DB_URL=jdbc:postgresql://localhost:5432/looped
DB_USERNAME=looped
DB_PASSWORD=looped
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# AWS / Media
AWS_REGION=us-east-1
S3_BUCKET=looped-dev-media
CLOUDFRONT_DOMAIN=

# Auth (Firebase or any OIDC JWT provider)
# Firebase defaults shown; override per environment
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
AUTH_JWKS_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# SQS
SQS_NOTIF_QUEUE_URL=
