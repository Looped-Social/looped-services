aws_region      = "us-east-1"
environment     = "prod"
name_prefix     = "looped"
domain_name     = "api.mylooped.app"

# You already have a cert for api.mylooped.app in us-east-1:
# arn:aws:acm:us-east-1:179388324981:certificate/d3b37b5c-baae-4329-bffa-aba09e2d5aba
acm_certificate_arn = "arn:aws:acm:us-east-1:179388324981:certificate/REPLACE_ME"

ecr_repository_name = "looped-api"
image_tag           = "prod"

desired_count = 2
min_capacity  = 2
max_capacity  = 6

# Prod default is multi-AZ NAT (higher availability, higher cost).
multi_az_nat = true

cors_allowed_origins = "https://admin.mylooped.app,https://mylooped.app,https://www.mylooped.app,https://looped-social.com,https://www.looped-social.com"

email_from              = "verify@mylooped.app"
email_admin_from        = "system@mylooped.app"
email_reply_to          = "support@mylooped.app"
email_configuration_set = "looped-email-events"
email_verify_base_url   = ""
app_minimum_supported_version = "1.0.3"
app_minimum_supported_version_message = ""
app_minimum_supported_version_update_url = "https://apps.apple.com/us/app/looped-social/id6758413180"
devices_app_attest_mode = "observe"
devices_app_attest_challenge_ttl = "5m"
devices_app_attest_trust_ttl = "30d"
devices_app_attest_allow_insecure_observed_trust = false

# Universal Links (AASA)
# appID will be "<universal_links_apple_team_id>.<universal_links_ios_bundle_id>"
universal_links_apple_team_id         = "YOUR_APPLE_TEAM_ID"
universal_links_ios_bundle_id         = "com.yourcompany.looped"
universal_links_cache_max_age_seconds = 300
universal_links_aasa_version          = "v1"

firebase_admin_secret_arn    = "arn:aws:secretsmanager:us-east-1:179388324981:secret:looped/prod/firebase-admin-XXXXXX"
openai_moderation_secret_arn = "arn:aws:secretsmanager:us-east-1:179388324981:secret:looped/openai/moderation-XXXXXX"
db_credentials_secret_arn    = "arn:aws:secretsmanager:us-east-1:179388324981:secret:looped/prod/db/credentials-XXXXXX"

db_url = "jdbc:postgresql://YOUR_NEON_HOST/YOUR_DB?sslmode=require"

auth_issuer   = "https://securetoken.google.com/YOUR_FIREBASE_PROJECT"
auth_audience = "YOUR_FIREBASE_PROJECT"
auth_jwks_uri = "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"

# Optional: custom media domain (CloudFront)
# 1) Request ACM cert for media.mylooped.app in us-east-1 (DNS validate via Cloudflare)
# 2) Set media.mylooped.app CNAME -> cloudfront_domain_name output
media_cloudfront_aliases = ["media.mylooped.app"]
media_cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:179388324981:certificate/REPLACE_ME"

moderation_enabled                    = true
moderation_openai_enabled             = true
moderation_openai_model               = "omni-moderation-latest"
moderation_openai_base_url            = "https://api.openai.com/v1"
moderation_openai_timeout_millis      = 5000
moderation_openai_daily_request_budget = 9000
moderation_openai_budget_redis_prefix  = "moderation:openai:requests"
moderation_openai_category_blocklist  = "hate,hate/threatening,sexual,sexual/minors,self-harm,self-harm/intent,self-harm/instructions,violence,violence/graphic"
moderation_report_quarantine_threshold = 10

# Push notifications (APNs via SQS + notif-worker)
# - enable_push_notifications controls whether the API enqueues push jobs to SQS.
# - enable_notif_worker controls whether we deploy the SQS consumer that actually sends APNs pushes.
enable_push_notifications = true
enable_notif_worker       = true

# Prod should use the production APNs host.
apns_sandbox = false

# Required when enable_notif_worker=true
apns_bundle_id              = "com.yourcompany.looped"
apns_team_id                = "YOUR_TEAM_ID"
apns_key_id                 = "YOUR_KEY_ID"
apns_auth_key_p8_secret_arn = "arn:aws:secretsmanager:us-east-1:179388324981:secret:looped/prod/apns/auth-key-p8-XXXXXX"

# Rate limits (optional overrides; defaults are 120/ip/min and 180/user/min)
rate_limit_enabled     = true
rl_ip_window_seconds   = 60
rl_ip_max_requests     = 5000
rl_user_window_seconds = 60
rl_user_max_requests   = 600
